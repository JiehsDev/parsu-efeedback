# =========================================================
# ParSU e-Feedback — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# =========================================================

# --- Database (MongoDB Atlas M0) ---
# Get from: Atlas dashboard → Database → Connect → Drivers
MONGODB_URI=

# --- Auth.js ---
# AUTH_SECRET: generate with `npx auth secret`
# AUTH_URL: your deployed URL locally use http://localhost:3000
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- File Storage (Cloudflare R2 — S3-compatible) ---
# Get from: Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Email (Resend) ---
# Get from: resend.com → API Keys. Sender domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Rate limiting / Cron (Upstash) ---
# Get from: console.upstash.com → Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# CRON_SECRET: any long random string; sent as a header by the scheduler and
# checked by /api/cron/sla-check to reject unauthenticated calls.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Business rule thresholds ---
# These are NOT secrets — they're configurable numbers/lists pulled from
# docs/business-rules.md so the rule (and its ID) has one canonical source
# instead of being hardcoded in application code. See that doc for the
# full rule text; defaults below are safe starting points.

# BR-013: failed-login lockout
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# BR-087: session inactivity expiry
AUTH_SESSION_MAX_AGE_MINUTES=60

# BR-061: max upload size (MB)
UPLOAD_MAX_FILE_SIZE_MB=10

# BR-060: comma-separated MIME allow-list (no spaces)
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# BR-036/BR-100: ticket number prefix, e.g. PARSU-2026-000001
TICKET_NUMBER_PREFIX=PARSU
