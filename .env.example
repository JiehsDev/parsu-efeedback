# Application Core URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Replace with your actual MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app-name>
# Auth.js Config (generate a secure one with 'npx auth secret' — never reuse a committed value)
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth

# Cloudflare R2 Object Storage (Placeholders to pass schema validation)
R2_ACCOUNT_ID=mock_r2_account_id_string
R2_ACCESS_KEY_ID=mock_access_key_id
R2_SECRET_ACCESS_KEY=mock_secret_access_key_long_string
R2_BUCKET_NAME=parsu-efeedback-dev
R2_PUBLIC_URL=https://cdn-dev.parsu-efeedback.edu.ph

# Resend Email Integration (Placeholders)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_DEV_TEST_EMAIL=your_dev_test_email@example.com

# Upstash Redis (Used for your IP Rate Limiter inside auth.ts)
UPSTASH_REDIS_REST_URL=https://mock-utility-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=mock_redis_rest_token_string

# System Maintenance Crons
CRON_SECRET=mock_cron_automation_secret_key_2026

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Business rule thresholds ---
# These are NOT secrets — they're configurable numbers/lists pulled from
# docs/business-rules.md so the rule (and its ID) has one canonical source
# instead of being hardcoded in application code. See that doc for the
# full rule text; defaults below are safe starting points.

# BR-013: failed-login lockout
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# BR-087: session inactivity expiry
AUTH_SESSION_MAX_AGE_MINUTES=60

# BR-061: max upload size (MB)
UPLOAD_MAX_FILE_SIZE_MB=10

# BR-060: comma-separated MIME allow-list (no spaces)
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# BR-036/BR-100: ticket number prefix, e.g. PARSU-2026-000001
TICKET_NUMBER_PREFIX=PARSU
